# Copy this file to .env.local and add your own key. .env.local is gitignored; never commit a real key.
# Create a key at https://console.anthropic.com (Settings → API keys).
ANTHROPIC_API_KEY=

# Rate-limit storage. Leave unset for local `npm run dev` (in-memory limits are used automatically).
# In production the AI route stays off until a shared store is configured. "memory" is single-instance only
# and NOT safe on AWS Amplify; use it only for local `npm run build && npm start` testing.
# In production on AWS Amplify, use "dynamodb" with the table below (credentials come from Amplify's compute role).
# RATE_LIMIT_STORE=
# RATE_LIMIT_TABLE=realestate-iq-rate-limits
# Optional. Only needed if the table is in a different AWS region from the app.
# RATE_LIMIT_REGION=

# Number of proxies in front of the app that append to X-Forwarded-For. Leave unset until verified on the
# real deployment. While unset, all visitors share one conservative limit, which forged headers can't bypass.
# TRUSTED_PROXY_HOPS=
